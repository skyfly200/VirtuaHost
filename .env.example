# Sign-in (set SESSION_SECRET plus a first admin in LOGIN_USERS, or ACCESS_KEY, or both; with none the API answers 503).
# LOGIN_USERS holds only the first admin(s): make each entry with `npm run hash-password -- alice`, join several with commas.
# Everyone else is added by an admin in the Users tab and stored in Netlify Blobs (docs/USERS.md).
LOGIN_USERS=
# A random string of 32+ characters that signs login tokens (openssl rand -hex 32).
SESSION_SECRET=
# SESSION_HOURS=12
# Optional key for scripts and curl: "x-api-key: <key>" or "Authorization: Bearer <key>". 16+ characters (openssl rand -hex 24).
ACCESS_KEY=
# Local development only: "true" turns the sign-in check off.
AUTH_DISABLED=

# ElevenLabs (voice clones). The site's key; people and stations can also save their own in the app. Optional names for voices:
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICES=Rocky=<voice id>,Britta=<voice id>

# US weather alerts (National Weather Service): the NWS asks for a contact in its User-Agent. Minimum severity for {{alert}} placeholders.
# ALERTS_CONTACT=you@example.com
# ALERT_MIN_SEVERITY=Moderate
# MCP endpoint (/api/mcp): true = offer only read tools
# MCP_READ_ONLY=false

# Protects the AI keys people and stations save in the app (32+ characters, openssl rand -hex 32). Falls back to SESSION_SECRET,
# but then changing SESSION_SECRET also makes every saved key unreadable. Set it once and keep it.
# SECRETS_KEY=

# Default limits for regular users with none of their own (empty = no limit; admins are never limited). Set per person in the Users tab.
# QUOTA_DAILY_AI=50
# QUOTA_MONTHLY_AI=1000
# QUOTA_MAX_CLIPS=200
# QUOTA_MAX_SCHEDULES=10

# The radio side. Leave empty until it exists: the Voice Lab and Stations tabs stay switched off. Addresses must be https.
# Chips Voice server (its API_KEY) -> Voice Lab tab
VOICE_URL=
VOICE_KEY=
# The hub (its HUB_KEY) -> Stations tab
HUB_URL=
HUB_KEY=

# AI provider. Set ONE of the two keys below (OpenRouter is recommended: one key, and you can pick the
# writing model and the voice model in the console or per request). If both are set, OpenRouter is used;
# set PROVIDER=gemini or PROVIDER=openrouter to force one.
OPENROUTER_API_KEY=
# Default and selectable models (comma lists; slugs from openrouter.ai/models). A speech entry may carry its
# default voice as "slug|Voice". Defaults are used when these are empty.
OPENROUTER_TEXT_MODEL=
OPENROUTER_TEXT_MODELS=
OPENROUTER_SPEECH_MODEL=
OPENROUTER_SPEECH_MODELS=
OPENROUTER_VOICE=
# "true" lets a request name any model slug, not only the listed ones (a key holder could then pick costly models).
OPENROUTER_ALLOW_ANY_MODEL=
PROVIDER=

# Google Gemini API key (direct, fixed models). Used when OPENROUTER_API_KEY is not set.
GEMINI_API_KEY=

# Optional: station name, used in the DJ persona prompt (defaults to "the station").
STATION_NAME=

# Optional: Gemini prebuilt voice name for TTS when using Gemini directly (defaults to "Kore").
GEMINI_TTS_VOICE=

# Netlify Blobs credentials are auto-injected by the Netlify runtime and by
# `netlify dev` when the site is linked -- nothing to set here for local dev.

# Optional: hand every generated clip to the station server (Chips Voice, next to Icecast/Liquidsoap).
# See docs/INTEGRATION.md. The token is the station's INGEST_TOKEN.
STATION_URL=
STATION_INGEST_TOKEN=
# "true" puts each generated clip on air; "true" lets it interrupt a live DJ. Both can be set per request.
STATION_AUTOPLAY=
STATION_PREEMPT=
# Effect the station applies to every clip it receives, e.g. underground (the KRAP sound), robot, telephone. Also per request via "fx".
STATION_FX=

# Sound library (sound effects and music beds), from OwnCloud and/or Google Drive. See docs/LIBRARY.md.
OWNCLOUD_URL=
OWNCLOUD_USER=
OWNCLOUD_PASSWORD=
OWNCLOUD_SFX_PATH=
OWNCLOUD_MUSIC_PATH=
GOOGLE_SERVICE_ACCOUNT_JSON=
GDRIVE_SFX_FOLDER=
GDRIVE_MUSIC_FOLDER=

# Station queue: STATION_MODE=queue puts every saved clip in a queue that the station daemon (station-daemon/) collects.
STATION_MODE=
STATION_KEY=

# Log verbosity: debug | info | warn | error | silent (default info)
#LOG_LEVEL=info
