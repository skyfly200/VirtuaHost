# Hub: see docs/HUB.md
HUB_KEY=                     # openssl rand -hex 24 (12+ characters)
# HUB_PORT=3200  HUB_HOST=0.0.0.0
# HUB_DATA=./data/hub.json
# VOICE_URL=https://voice.example.com  VOICE_KEY=   # a Chips Voice server, to broadcast clips by id
# HUB_CORS_ORIGIN=            # only if a browser calls the hub directly; the site's UI goes through its /api/hub proxy
# HUB_READ_KEY=           # a second key that can only read (stations, items, audit)
# SITE_URL=https://your-site.netlify.app  SITE_KEY=   # a SERVICE_KEYS key (generate+stations.read+personas.read) so the hub can write and speak just-in-time lines
