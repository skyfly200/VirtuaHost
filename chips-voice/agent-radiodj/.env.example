# RadioDJ agent (Windows): see docs/HUB.md
AGENT_KEY=                   # required
# AGENT_PORT=3100  AGENT_HOST=0.0.0.0  STATION_NAME=Studio
RADIODJ_URL=http://127.0.0.1:8080
RADIODJ_PASS=
LINKS_DIR=C:\KRAP\Links      # a RadioDJ cart plays CLIP_FILE from here
# CLIP_FILE=current_link.mp3
CLIP_CART=                   # the cart number that plays that file
# RADIODJ_CMD_SKIP=          # the REST plugin command that skips (not confirmed; see docs/HUB.md)
# RADIODJ_CMD_VOLUME=  VOLUME_SCALE=100
# MUSIC_DIR=D:\Music         # lets the hub see the library
