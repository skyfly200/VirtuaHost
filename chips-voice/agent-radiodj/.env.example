# RadioDJ agent (Windows): see docs/HUB.md (sections 1, 10, 11)
# Keys: AGENT_KEY alone = read + control (older setups). Better: separate keys, optionally one pair per hub.
AGENT_CONTROL_KEY=           # openssl rand -hex 24
AGENT_READ_KEY=
# AGENT_KEYS=hubA:read:xxxx,hubA:control:yyyy
# Listens on 127.0.0.1 only. Exposing it needs AGENT_HOST=... and should be behind a tunnel (Tailscale/Cloudflare). Prefer the pull model below.
# AGENT_PORT=3100  AGENT_HOST=127.0.0.1  STATION_NAME=Green Light Radio
RADIODJ_URL=http://127.0.0.1:8080
RADIODJ_PASS=
BROADCAST_TZ=America/Denver  # the station's clock
MACHINE_TZ=America/Chicago   # this PC's clock (only for reading the PC's own timestamps)
AGENT_SHADOW=true            # generated clips, inserts and playlist loads are logged but NOT executed. false = live (after the owner approves)
AGENT_DATA_DIR=C:\GreenLightRadio\agent   # audit.jsonl, state.json, KILL (kill switch flag), mode (live-show|automation)
LINKS_DIR=C:\GreenLightRadio\clips        # one hash-named file per clip
# CLIP_CART=                 # legacy: the cart that plays CLIP_FILE (a copy of the newest clip); fires with PlayCartByNumber
# PLAY_EXEC=                 # or a script: PLAY_EXEC="python C:\GreenLightRadio\play_clip.py"  (gets <file> <title>)
# INSERT_EXEC="python C:\GreenLightRadio\insert_clip.py"   # gets <file> <position> <replace-id>. NEEDS LIVE VERIFICATION
# RADIODJ_CMD_INSERT=  RADIODJ_INSERT_ARG={path}|{position}  # alternative: a REST plugin command you have verified
# LOAD_EXEC="C:\GreenLightRadio\load_playlist.cmd"        # loads "GLR YYYY-MM-DD*"
# RADIODJ_CMD_SKIP=  RADIODJ_SKIP_VERIFIED=false           # skip only after testing it on the real RadioDJ
# RADIODJ_CMD_VOLUME=  VOLUME_SCALE=100
# SCHEDULE_DIR=C:\GreenLightRadio\plans  ICECAST_URL=http://127.0.0.1:8000  ICECAST_MOUNT=/stream
# WATCHDOG_FILE=  LOADED_PLAYLIST_FILE=  MUSIC_DIR=D:\Music  AGENT_ALLOW=ingest,play-clip,insert,load-playlist
# Pull model (a PC behind home NAT): the agent calls the hub, nothing calls it.
# HUB_URL=https://hub.example.com  HUB_STATION_ID=green-light-radio  HUB_STATION_KEY=pk_...  HUB_POLL_SECONDS=15
